# --- Core ---
APP_NAME=HotelSave
ENVIRONMENT=development
# Postgres in prod, e.g. postgresql+psycopg2://user:pass@localhost:5432/hotelsave
# SQLite by default for zero-config local dev:
DATABASE_URL=sqlite:///./hotelsave.db

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# --- Price source (§9) ---
# mock | hotellook  — keep the interface so swapping is a one-line change.
PRICE_SOURCE=mock
# Travelpayouts / Hotellook Data API (needed only when PRICE_SOURCE=hotellook):
#   TOKEN  — Data API token (authenticates lookup + search)
#   MARKER — affiliate/partner ID, embedded in rebook deep-links for commission
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Optional: a customer IP to region-price the search (leave blank to omit).
TRAVELPAYOUTS_CUSTOMER_IP=
# Drop floor (§7 rule 4): a candidate must beat original by more than max(abs, pct).
DROP_FLOOR_ABS=10.0
DROP_FLOOR_PCT=0.03
# Deadline guard (§8): fire "Deadline Approaching" this many hours before the deadline.
DEADLINE_ALERT_HOURS=48

# --- Parse (§6a): booking parser + LLM ---
# mock | claude  — mock needs no API key and powers local dev + tests.
PARSER=mock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Inbound email (§5) ---
# Optional shared secret appended to the webhook URL (?token=...), since inbound
# providers can't send bearer auth. Leave blank to disable the check.
INBOUND_WEBHOOK_SECRET=

# --- Stripe (§11) — leave blank until you wire real keys ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Klaviyo (§10) — leave blank to log events instead of sending ---
KLAVIYO_API_KEY=
